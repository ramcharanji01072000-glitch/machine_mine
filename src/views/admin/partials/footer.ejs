  </main>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.querySelectorAll('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm)) e.preventDefault(); }));
  // Give each cell its column name so phone layouts can show "Label: value" rows.
  document.querySelectorAll('table.table-stack').forEach((table) => {
    const labels = [...table.querySelectorAll('thead th')].map((th) => th.textContent.trim());
    table.querySelectorAll('tbody tr').forEach((tr) =>
      [...tr.children].forEach((td, i) => { if (!td.hasAttribute('colspan')) td.dataset.label = labels[i] || ''; }));
  });
</script>
</body>
</html>
