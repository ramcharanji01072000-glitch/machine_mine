<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#16181d">
  <title><%= title %> · MachineMine Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f5f6f8; }
    /* Bootstrap's .offcanvas-lg forces a transparent background on large screens; keep it dark. */
    nav.sidebar, nav.sidebar.offcanvas-lg { background-color: #16181d !important; }
    .sidebar .nav-link { color: #b8bcc6; padding: 11px 20px; border-left: 3px solid transparent; border-radius: 0; }
    .sidebar .nav-link:hover { color: #fff; background: #1f2229; }
    .sidebar .nav-link.active { color: #fff; background: #1f2229; border-left-color: #dc3545; }
    .brand { color: #fff; font-weight: 700; font-size: 18px; text-decoration: none; }
    .stat { font-size: 1.6rem; font-weight: 600; }
    .table td, .table th { vertical-align: middle; white-space: nowrap; }
    .thumb { width: 56px; height: 40px; object-fit: cover; border-radius: 4px; background: #e9ecef; }
    .mobile-bar { background: #16181d; position: sticky; top: 0; z-index: 1030; }

    /* Desktop: fixed-width sidebar that stays in view. */
    @media (min-width: 992px) {
      .sidebar { width: 230px; min-height: 100vh; position: sticky; top: 0; align-self: flex-start; height: 100vh; overflow-y: auto; }
    }

    /* Phones: tables turn into stacked cards; labels come from the header (see footer script). */
    @media (max-width: 767.98px) {
      .stat { font-size: 1.3rem; }
      h4.page-title { font-size: 1.2rem; }
      .table-stack thead { display: none; }
      .table-stack, .table-stack tbody, .table-stack tr, .table-stack td { display: block; width: 100%; }
      .table-stack tr { padding: 10px 14px; border-bottom: 1px solid #e9ecef; }
      .table-stack tr:last-child { border-bottom: 0; }
      /* Label floats left; the value (which may span several lines) stays grouped on the right. */
      .table-stack td { border: 0 !important; padding: 4px 0 !important; white-space: normal; text-align: right !important;
                        max-width: none !important; overflow: hidden; word-break: break-word; }
      .table-stack td::before { content: attr(data-label); float: left; margin-right: 12px; color: #6c757d; font-size: .8rem; line-height: 1.6; }
      .table-stack td[data-label=""]::before, .table-stack td[colspan]::before { content: none; }
      .table-stack td[data-label=""] { text-align: left !important; }
      .table-stack td[colspan] { text-align: center !important; }
      .table-stack td.text-truncate { text-overflow: clip; }
      .table-stack td form { margin-top: 4px; }
      .btn-sm { padding: .35rem .7rem; }
    }
  </style>
</head>
<body>
<% const nav = [['/', 'Dashboard'], ['/users', 'Users'], ['/products', 'Products'], ['/purchases', 'Purchases'], ['/withdrawals', 'Withdrawals'], ['/transactions', 'Transactions'], ['/carousel', 'Carousel'], ['/settings', 'Settings']]; %>

<!-- Phone/tablet top bar -->
<header class="mobile-bar d-flex d-lg-none align-items-center px-3 py-2">
  <button class="btn btn-sm btn-outline-light me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">☰</button>
  <a href="/admin" class="brand">⛏ MachineMine</a>
</header>

<div class="d-lg-flex">
  <nav id="sidebar" class="sidebar offcanvas-lg offcanvas-start flex-shrink-0" tabindex="-1" aria-label="Admin menu">
    <div class="d-flex align-items-center justify-content-between px-3 py-3">
      <a href="/admin" class="brand">⛏ MachineMine</a>
      <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
    </div>
    <div class="nav flex-column">
      <% nav.forEach(([href, label]) => { const active = href === '/' ? path === '/' : path.startsWith(href); %>
        <a href="/admin<%= href === '/' ? '' : href %>" class="nav-link <%= active ? 'active' : '' %>"><%= label %></a>
      <% }) %>
    </div>
    <form method="post" action="/admin/logout" class="px-3 mt-3 pb-4">
      <button class="btn btn-sm btn-outline-light w-100">Logout (<%= admin.username %>)</button>
    </form>
  </nav>
  <main class="flex-grow-1 p-3 p-md-4" style="min-width:0">
    <h4 class="mb-3 page-title"><%= title %></h4>
    <% if (flash.ok) { %><div class="alert alert-success py-2"><%= flash.ok %></div><% } %>
    <% if (flash.err) { %><div class="alert alert-danger py-2"><%= flash.err %></div><% } %>
