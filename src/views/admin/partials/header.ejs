<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · MachineMine Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f5f6f8; }
    .sidebar { width: 220px; min-height: 100vh; background: #16181d; }
    .sidebar a { color: #b8bcc6; text-decoration: none; display: block; padding: 10px 20px; border-left: 3px solid transparent; }
    .sidebar a:hover { color: #fff; background: #1f2229; }
    .sidebar a.active { color: #fff; background: #1f2229; border-left-color: #dc3545; }
    .brand { color: #fff; font-weight: 700; padding: 18px 20px; font-size: 18px; }
    .stat { font-size: 1.6rem; font-weight: 600; }
    .table td, .table th { vertical-align: middle; white-space: nowrap; }
    .thumb { width: 56px; height: 40px; object-fit: cover; border-radius: 4px; background: #e9ecef; }
    @media (max-width: 768px) { .sidebar { width: 100%; min-height: auto; } .layout { flex-direction: column; } }
  </style>
</head>
<body>
<div class="d-flex layout">
  <nav class="sidebar flex-shrink-0">
    <div class="brand">⛏ MachineMine</div>
    <% const nav = [['/', 'Dashboard'], ['/users', 'Users'], ['/products', 'Products'], ['/purchases', 'Purchases'], ['/withdrawals', 'Withdrawals'], ['/transactions', 'Transactions'], ['/carousel', 'Carousel'], ['/settings', 'Settings']]; %>
    <% nav.forEach(([href, label]) => { const active = href === '/' ? path === '/' : path.startsWith(href); %>
      <a href="/admin<%= href === '/' ? '' : href %>" class="<%= active ? 'active' : '' %>"><%= label %></a>
    <% }) %>
    <form method="post" action="/admin/logout" class="px-3 mt-3">
      <button class="btn btn-sm btn-outline-light w-100">Logout (<%= admin.username %>)</button>
    </form>
  </nav>
  <main class="flex-grow-1 p-3 p-md-4" style="min-width:0">
    <h4 class="mb-3"><%= title %></h4>
    <% if (flash.ok) { %><div class="alert alert-success py-2"><%= flash.ok %></div><% } %>
    <% if (flash.err) { %><div class="alert alert-danger py-2"><%= flash.err %></div><% } %>
