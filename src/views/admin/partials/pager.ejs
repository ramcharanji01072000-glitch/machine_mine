<% const pages = Math.max(1, Math.ceil(total / pageSize));
   const link = (p) => {
     const u = new URLSearchParams();
     Object.entries(query).forEach(([k, v]) => { if (!['ok', 'err', 'page'].includes(k) && typeof v === 'string') u.set(k, v); });
     u.set('page', p);
     return '?' + u.toString();
   }; %>
<div class="d-flex justify-content-between align-items-center mt-2">
  <small class="text-muted"><%= total %> record(s) · page <%= page %> of <%= pages %></small>
  <div class="btn-group btn-group-sm">
    <a class="btn btn-outline-secondary <%= page <= 1 ? 'disabled' : '' %>" href="<%= link(page - 1) %>">‹ Prev</a>
    <a class="btn btn-outline-secondary <%= page >= pages ? 'disabled' : '' %>" href="<%= link(page + 1) %>">Next ›</a>
  </div>
</div>
