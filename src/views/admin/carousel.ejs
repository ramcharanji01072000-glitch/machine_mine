<%- include('partials/header', { title: 'Home carousel' }) %>
<div class="card card-body mb-3">
  <h6>Add slide</h6>
  <form method="post" action="/admin/carousel" enctype="multipart/form-data" class="row g-2 align-items-end">
    <div class="col-md-4"><input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control" required></div>
    <div class="col-md-3"><input name="caption" class="form-control" placeholder="Caption"></div>
    <div class="col-md-2"><input name="routes" class="form-control" placeholder="Route (optional)"></div>
    <div class="col-md-1"><input name="order" type="number" class="form-control" value="0" title="Order"></div>
    <div class="col-md-1 form-check ms-2 mb-2"><input class="form-check-input" type="checkbox" name="status" id="ns" checked><label for="ns" class="form-check-label">On</label></div>
    <div class="col-md-auto"><button class="btn btn-primary">Add</button></div>
  </form>
</div>
<div class="row g-3">
  <% slides.forEach((s) => { %>
  <div class="col-md-6 col-xl-4">
    <div class="card h-100">
      <img src="<%= s.image %>" class="card-img-top" style="height:160px;object-fit:cover;background:rgba(255,255,255,.06)" alt="">
      <form method="post" action="/admin/carousel/<%= s._id %>" enctype="multipart/form-data" class="card-body vstack gap-2">
        <input name="caption" class="form-control form-control-sm" value="<%= s.caption %>" placeholder="Caption">
        <div class="d-flex gap-2">
          <input name="routes" class="form-control form-control-sm" value="<%= s.routes %>" placeholder="Route">
          <input name="order" type="number" class="form-control form-control-sm" style="width:80px" value="<%= s.order %>">
        </div>
        <input name="image" type="file" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control form-control-sm">
        <div class="d-flex align-items-center gap-2">
          <div class="form-check form-switch me-auto"><input class="form-check-input" type="checkbox" name="status" <%= s.status ? 'checked' : '' %>><label class="form-check-label small">Visible</label></div>
          <button class="btn btn-sm btn-dark">Save</button>
        </div>
      </form>
      <form method="post" action="/admin/carousel/<%= s._id %>/delete" class="card-footer text-end" data-confirm="Delete this slide?">
        <button class="btn btn-sm btn-link text-danger">Delete</button></form>
    </div>
  </div>
  <% }) %>
  <% if (!slides.length) { %><p class="text-muted">No slides yet.</p><% } %>
</div>
<%- include('partials/footer') %>
