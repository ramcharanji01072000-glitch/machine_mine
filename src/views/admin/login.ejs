<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#060a13">
  <title>Admin Login · MachineMine</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%- include('partials/theme') %>
</head>
<body class="d-flex align-items-center justify-content-center p-3" style="min-height:100vh">
  <div class="orbs" aria-hidden="true"><span class="orb orb-blue"></span><span class="orb orb-gold"></span><span class="orb orb-cyan"></span></div>
  <form method="post" action="/admin/login" class="glass p-4 p-sm-5" style="width:100%;max-width:400px">
    <div class="d-flex align-items-center gap-2 mb-4">
      <div class="logo-mark">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4.5 19 9l-9.5 9.5H5v-4.5z"/><path d="M12.5 6.5l5 5"/></svg>
      </div>
      <div class="lh-sm"><div class="brand">MachineMine</div><div class="brand-sub">Admin console</div></div>
    </div>
    <h1 class="page-title mb-1">Welcome back</h1>
    <p class="text-muted small mb-4">Sign in to manage users, machines and payouts.</p>
    <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
    <label class="form-label" for="u">Username</label>
    <input class="form-control mb-3" id="u" name="username" autocomplete="username" required autofocus>
    <label class="form-label" for="p">Password</label>
    <input class="form-control mb-4" id="p" name="password" type="password" autocomplete="current-password" required>
    <button class="btn btn-primary w-100 py-2">Sign in</button>
  </form>
</body>
</html>
