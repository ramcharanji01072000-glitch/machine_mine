<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Login · MachineMine</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="min-height:100vh">
  <form method="post" action="/admin/login" class="card p-4 shadow" style="width:340px">
    <h4 class="mb-3 text-center">⛏ MachineMine Admin</h4>
    <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
    <input class="form-control mb-2" name="username" placeholder="Username" required autofocus>
    <input class="form-control mb-3" name="password" type="password" placeholder="Password" required>
    <button class="btn btn-danger w-100">Login</button>
  </form>
</body>
</html>
