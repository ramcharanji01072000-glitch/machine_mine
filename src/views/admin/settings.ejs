<%- include('partials/header', { title: 'Settings' }) %>
<div class="row g-3">
  <div class="col-lg-8">
    <form method="post" action="/admin/settings" enctype="multipart/form-data" class="card card-body">
      <h6>App logo <small class="text-muted">(splash, login &amp; About screens)</small></h6>
      <div class="d-flex align-items-center gap-3 mb-3">
        <% if (s.logo) { %>
          <img src="<%= s.logo %>" alt="" style="width:64px;height:64px;object-fit:contain;border-radius:14px;background:rgba(255,255,255,.06)">
        <% } else { %>
          <div class="text-muted small" style="width:64px;height:64px;border-radius:14px;background:rgba(255,255,255,.06);display:grid;place-items:center">None</div>
        <% } %>
        <div class="flex-grow-1">
          <input name="logo" type="file" accept="image/png,image/jpeg,image/webp" class="form-control">
          <div class="form-text">Square PNG with a transparent background works best. Leave empty to keep the current logo.</div>
          <% if (s.logo) { %>
            <div class="form-check mt-1"><input class="form-check-input" type="checkbox" name="removeLogo" id="rl"><label class="form-check-label small" for="rl">Remove logo (app shows its default icon)</label></div>
          <% } %>
        </div>
      </div>
      <h6>App info <small class="text-muted">(About Us screen &amp; links)</small></h6>
      <div class="mb-2"><label class="form-label">About us</label><textarea name="aboutUs" rows="6" class="form-control"><%= s.aboutUs %></textarea></div>
      <div class="row g-2 mb-3">
        <div class="col-md-4"><label class="form-label">Android link</label><input name="androidLink" type="url" class="form-control" value="<%= s.androidLink || '' %>"></div>
        <div class="col-md-4"><label class="form-label">iOS link</label><input name="iosLink" type="url" class="form-control" value="<%= s.iosLink || '' %>"></div>
        <div class="col-md-4"><label class="form-label">Telegram channel</label><input name="telegram" type="url" class="form-control" value="<%= s.telegram || '' %>"></div>
      </div>
      <h6>Referral commission <small class="text-muted">(% of product price, paid when a team member buys)</small></h6>
      <div class="row g-2 mb-3">
        <% [1, 2, 3].forEach((l) => { %>
        <div class="col-4"><label class="form-label">Level <%= l %> %</label>
          <input name="referralLevel<%= l %>" type="number" step="0.01" min="0" max="100" class="form-control" value="<%= s['referralLevel' + l] %>"></div>
        <% }) %>
      </div>
      <h6>Wallet</h6>
      <div class="row g-2 mb-3">
        <div class="col-md-6"><label class="form-label">Minimum withdraw (₹)</label>
          <input name="minWithdraw" type="number" step="0.01" min="0" class="form-control" value="<%= fmt(s.minWithdrawPaise) %>"></div>
        <div class="col-md-6"><label class="form-label">Signup bonus (₹)</label>
          <input name="signupBonus" type="number" step="0.01" min="0" class="form-control" value="<%= fmt(s.signupBonusPaise) %>"></div>
      </div>

      <h6>Withdrawal taxes <small class="text-muted">(deducted from every withdrawal, in this order)</small></h6>
      <style>
        /* Phones: each tax on two lines — [name ✕] / [₹|% amount] — so nothing gets squeezed. */
        @media (max-width: 575.98px) {
          .tax-row { display: grid !important; grid-template-columns: 84px 1fr 38px; gap: 8px;
                     padding: 10px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,.02); }
          .tax-row .tax-name { grid-column: 1 / 3; }
          .tax-row .tax-remove { grid-column: 3; grid-row: 1; }
          .tax-row .tax-type { grid-column: 1; }
          .tax-row .tax-value { grid-column: 2 / 4; }
        }
      </style>
      <div id="taxRows" class="vstack gap-2 mb-2">
        <% taxes.forEach((t) => { %>
          <div class="tax-row d-flex gap-2 align-items-center">
            <input name="taxName" class="form-control tax-name" placeholder="Tax name (e.g. GST)" maxlength="40" value="<%= t.name %>" style="flex:2 1 0;min-width:0">
            <select name="taxType" class="form-select tax-type" style="flex:0 0 78px">
              <option value="fixed" <%= t.type === 'fixed' ? 'selected' : '' %>>₹</option>
              <option value="percent" <%= t.type === 'percent' ? 'selected' : '' %>>%</option>
            </select>
            <input name="taxValue" type="number" step="0.01" min="0" class="form-control tax-value" placeholder="Amount"
              value="<%= t.type === 'fixed' ? fmt(t.value) : t.value %>" style="flex:1 1 0;min-width:0">
            <button type="button" class="icon-btn flex-shrink-0 tax-remove" title="Remove tax" aria-label="Remove tax">✕</button>
          </div>
        <% }) %>
      </div>
      <button type="button" id="taxAdd" class="btn btn-sm btn-outline-light mb-2">+ Add tax</button>
      <div class="form-text mb-3" id="taxExample"></div>
      <template id="taxRowTpl">
        <div class="tax-row d-flex gap-2 align-items-center">
          <input name="taxName" class="form-control tax-name" placeholder="Tax name (e.g. GST)" maxlength="40" style="flex:2 1 0;min-width:0">
          <select name="taxType" class="form-select tax-type" style="flex:0 0 78px"><option value="fixed" selected>₹</option><option value="percent">%</option></select>
          <input name="taxValue" type="number" step="0.01" min="0" class="form-control tax-value" placeholder="Amount" style="flex:1 1 0;min-width:0">
          <button type="button" class="icon-btn flex-shrink-0 tax-remove" title="Remove tax" aria-label="Remove tax">✕</button>
        </div>
      </template>
      <h6>Terms &amp; Conditions <small class="text-muted">(shown in the app, at signup, and at <a href="/terms" target="_blank" rel="noopener">/terms</a>)</small></h6>
      <div class="mb-3">
        <textarea name="terms" rows="12" class="form-control" placeholder="1. Eligibility&#10;2. Deposits and withdrawals&#10;3. Withdrawal tax&#10;…" style="font-size:.9rem;line-height:1.6"><%= s.terms || '' %></textarea>
        <div class="form-text">Plain text. Line breaks are kept. Users must accept these when creating an account.</div>
      </div>
      <div><button class="btn btn-primary">Save settings</button></div>
      <script>
        (function () {
          const rows = document.getElementById('taxRows'), out = document.getElementById('taxExample');
          const tpl = document.getElementById('taxRowTpl');
          const MAX = 10;
          // Live example on a ₹1,000 withdrawal, mirroring the server's calculation.
          const show = () => {
            const items = [...rows.querySelectorAll('.tax-row')].map((r) => {
              const name = r.querySelector('[name=taxName]').value.trim();
              const type = r.querySelector('[name=taxType]').value;
              const v = Number(r.querySelector('[name=taxValue]').value) || 0;
              return { name, amt: v <= 0 || !name ? 0 : type === 'fixed' ? v : 1000 * Math.min(100, v) / 100 };
            }).filter((t) => t.amt > 0);
            const total = items.reduce((a, t) => a + t.amt, 0);
            out.textContent = items.length
              ? `Example on ₹1,000: ${items.map((t) => `${t.name} ₹${t.amt.toFixed(2)}`).join(' + ')} = ₹${total.toFixed(2)} tax → user receives ₹${(1000 - total).toFixed(2)}.`
              : 'No taxes: users receive the full withdrawal amount. Rows with an empty name or zero amount are ignored.';
            document.getElementById('taxAdd').disabled = rows.children.length >= MAX;
          };
          document.getElementById('taxAdd').addEventListener('click', () => {
            if (rows.children.length >= MAX) return;
            rows.appendChild(tpl.content.firstElementChild.cloneNode(true));
            rows.lastElementChild.querySelector('[name=taxName]').focus();
            show();
          });
          rows.addEventListener('click', (e) => { if (e.target.closest('.tax-remove')) { e.target.closest('.tax-row').remove(); show(); } });
          rows.addEventListener('input', show);
          rows.addEventListener('change', show);
          if (!rows.children.length) document.getElementById('taxAdd').click(); else show();
        })();
      </script>
    </form>
  </div>
  <div class="col-lg-4">
    <form method="post" action="/admin/account/password" class="card card-body">
      <h6>Change admin password</h6>
      <input name="current" type="password" class="form-control mb-2" placeholder="Current password" required>
      <input name="next" type="password" minlength="8" class="form-control mb-2" placeholder="New password (min 8)" required>
      <button class="btn btn-outline-dark">Change password</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
