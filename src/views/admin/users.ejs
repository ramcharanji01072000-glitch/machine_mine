<%- include('partials/header', { title: 'Users' }) %>
<form class="row g-2 mb-3">
  <div class="col-md-5"><input class="form-control" name="q" value="<%= q %>" placeholder="Search name, mobile, invite code or ID"></div>
  <div class="col-auto form-check mt-2 ms-2">
    <input class="form-check-input" type="checkbox" name="blocked" value="1" id="blk" <%= query.blocked === '1' ? 'checked' : '' %>>
    <label class="form-check-label" for="blk">Blocked only</label>
  </div>
  <div class="col-auto"><button class="btn btn-dark">Search</button></div>
</form>
<div class="card"><div class="table-responsive"><table class="table table-stack table-hover mb-0">
  <thead><tr><th>ID</th><th>Name</th><th>Mobile</th><th>Invite code</th><th>Referred by</th><th class="text-end">Balance</th><th>Status</th><th>Joined</th></tr></thead>
  <tbody>
  <% users.forEach((u) => { %>
    <tr style="cursor:pointer" onclick="location='/admin/users/<%= u.id %>'">
      <td><%= u.id %></td>
      <td><a href="/admin/users/<%= u.id %>"><%= u.name %></a></td>
      <td><%= u.mobile %></td>
      <td><code><%= u.inviteCode %></code></td>
      <td><%= u.referredBy || '-' %></td>
      <td class="text-end">₹<%= fmt(u.balancePaise) %></td>
      <td><%- u.isBlocked ? '<span class="badge text-bg-danger">Blocked</span>' : '<span class="badge text-bg-success">Active</span>' %></td>
      <td><%= dt(u.createdAt) %></td>
    </tr>
  <% }) %>
  <% if (!users.length) { %><tr><td colspan="8" class="text-center text-muted py-4">No users found</td></tr><% } %>
  </tbody>
</table></div></div>
<%- include('partials/pager') %>
<%- include('partials/footer') %>
