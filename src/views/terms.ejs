<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#060a13">
  <title>Terms &amp; Conditions · MachineMine</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    :root { --bg: #060a13; --panel: rgba(16, 22, 36, .7); --line: rgba(255, 255, 255, .08); --text: #e8ebf4; --muted: #8a93a8; }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--text);
           font-family: 'Plus Jakarta Sans', system-ui, sans-serif; line-height: 1.7;
           background-image: radial-gradient(500px circle at 0% 60%, rgba(47, 123, 255, .28), transparent 60%),
                             radial-gradient(380px circle at 95% 0%, rgba(245, 158, 11, .22), transparent 60%); }
    main { max-width: 760px; margin: 0 auto; padding: 40px 16px 64px; }
    h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: -.02em; margin: 0 0 4px; }
    .sub { color: var(--muted); font-size: .9rem; margin-bottom: 24px; }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: 20px; padding: 24px; white-space: pre-wrap; word-wrap: break-word; }
    .empty { color: var(--muted); }
  </style>
</head>
<body>
  <main>
    <h1>Terms &amp; Conditions</h1>
    <div class="sub">MachineMine<% if (terms && updatedAt) { %> · Last updated <%= new Date(updatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %><% } %></div>
    <div class="card"><% if (terms) { %><%= terms %><% } else { %><span class="empty">Terms &amp; Conditions have not been published yet.</span><% } %></div>
  </main>
</body>
</html>
