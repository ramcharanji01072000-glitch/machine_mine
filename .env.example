PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/machinemine

# REQUIRED in production - use long random strings
JWT_SECRET=change-me-user-token-secret
ADMIN_JWT_SECRET=change-me-admin-session-secret
JWT_EXPIRES_IN=30d

# First admin account (created on startup only if no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# Optional: where /signup/:code invite links should redirect (Flutter web build URL)
WEB_APP_URL=

NODE_ENV=development
